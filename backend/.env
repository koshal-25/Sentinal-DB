# Sentinel CRMS — Environment Variables
# Copy this to .env and fill in your values

PORT=3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=sentinel_v2

# JWT Secrets (change these in production!)
JWT_SECRET=sentinel_dev_secret_change_in_production
JWT_REFRESH_SECRET=sentinel_refresh_secret_change_in_production

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
